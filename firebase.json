{
 "hosting": [
  {
   "public": "public",
   "ignore": [
    "firebase.json",
    "**/.*"
   ],
   "headers": [
    {
     "source": "**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "no-cache"
      }
     ]
    },
    {
     "source": "/bg/**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "public, max-age=86400"
      }
     ]
    },
    {
     "source": "/app/bg/**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "public, max-age=86400"
      }
     ]
    }
   ],
   "site": "my-smart-classroom-fe1ad"
  },
  {
   "public": "public-cb",
   "ignore": [
    "firebase.json",
    "**/.*"
   ],
   "headers": [
    {
     "source": "**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "no-cache"
      }
     ]
    },
    {
     "source": "/bg/**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "public, max-age=86400"
      }
     ]
    },
    {
     "source": "/app/bg/**",
     "headers": [
      {
       "key": "Cache-Control",
       "value": "public, max-age=86400"
      }
     ]
    }
   ],
   "site": "classroomboard"
  }
 ],
 "firestore": {
  "rules": "firestore.rules"
 }
}