rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // ClassroomBoard Cast pairing. Short-lived, small, one answer per code. No listing.
    match /cast/{code} {
      allow get: if code.matches('[0-9]{6}');
      allow create: if code.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['offer','exp','v'])
        && request.resource.data.offer is string && request.resource.data.offer.size() < 20000
        && request.resource.data.exp is number
        && request.resource.data.exp <= request.time.toMillis() + 660000;
      allow update: if resource.data.exp > request.time.toMillis()
        && !('answer' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','name'])
        && request.resource.data.answer is string && request.resource.data.answer.size() < 20000
        && request.resource.data.name is string && request.resource.data.name.size() < 60;
      allow delete: if code.matches('[0-9]{6}');
    }
  }
}
